    "defaultMode": "auto",
    "additionalDirectories": [
      "/private/tmp"
    ]
  },
  "model": "haiku",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git commit -m *)",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Use a temporary file and -F instead' >&2; exit 2"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/aaron.lang/.claude/hooks/log-permission-requests.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/aaron.lang/.claude/hooks/auto-install-deps.sh",
            "timeout": 120,
            "statusMessage": "Installing dependencies..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "fastMode": true,
  "theme": "light",
  "skipAutoPermissionPrompt": true
}
