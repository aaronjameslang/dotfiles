{
  "alwaysThinkingEnabled": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "effortLevel": "medium",
  "enabledPlugins": {
    "figma@claude-plugins-official": true
  },
  "fastMode": true,
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "afplay /System/Library/Sounds/Glass.aiff",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "/Users/aaron.lang/.claude/hooks/log-permission-requests.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "echo 'Use a temporary file and -F instead' >&2; exit 2",
            "type": "command"
          }
        ],
        "matcher": "Bash(git commit -m *)"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "/Users/aaron.lang/.claude/hooks/auto-install-deps.sh",
            "statusMessage": "Installing dependencies...",
            "timeout": 120,
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(echo $?)",
      "Bash(fnm current:*)",
      "Bash(fnm use:*)",
      "Bash(gh api repos/*/*/commits/*)",
      "Bash(gh api repos/*/*/issues/*/comments*)",
      "Bash(gh api repos/*/*/pulls*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr create*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr list*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr status*)",
      "Bash(gh pr view*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(git add*)",
      "Bash(git add:*)",
      "Bash(git branch*)",
      "Bash(git checkout *)",
      "Bash(git cherry-pick:*)",
      "Bash(git commit:*)",
      "Bash(git diff*)",
      "Bash(git fetch*)",
      "Bash(git log*)",
      "Bash(git merge *)",
      "Bash(git merge origin/main)",
      "Bash(git pull *)",
      "Bash(git push*)",
      "Bash(git rebase *)",
      "Bash(git rebase --continue)",
      "Bash(git rebase origin/main)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git rm:*)",
      "Bash(git stash pop)",
      "Bash(git stash)",
      "Bash(git status)",
      "Bash(make build *)",
      "Bash(mktemp:*)",
      "Bash(node --version:*)",
      "Bash(npm audit fix)",
      "Bash(npm audit:*)",
      "Bash(npm ci --prefer-offline)",
      "Bash(npm i --ignore-scripts)",
      "Bash(npm i)",
      "Bash(npm install 2>&1)",
      "Bash(npm install*)",
      "Bash(npm ls *)",
      "Bash(npm view:*)",
      "Bash(npx biome:*)",
      "Bash(npx eslint *)",
      "Bash(npx knip:*)",
      "Bash(npx prettier*)",
      "Bash(npx tsc *)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest:*)",
      "Bash(pnpm biome:*)",
      "Bash(pnpm format:check)",
      "Bash(pnpm install:*)",
      "Bash(pnpm jscpd:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm test:*)",
      "Bash(pnpm tsc:*)",
      "Bash(pnpm type-check:*)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm view *)",
      "WebFetch(domain:www.figma.com)",
      "mcp__linear-server__get_authenticated_user",
      "mcp__linear-server__get_document",
      "mcp__linear-server__get_initiative",
      "mcp__linear-server__get_issue",
      "mcp__linear-server__get_milestone",
      "mcp__linear-server__get_project",
      "mcp__linear-server__get_user",
      "mcp__linear-server__list_comments",
      "mcp__linear-server__list_cycles",
      "mcp__linear-server__list_documents",
      "mcp__linear-server__list_initiatives",
      "mcp__linear-server__list_issue_labels",
      "mcp__linear-server__list_issue_statuses",
      "mcp__linear-server__list_issues",
      "mcp__linear-server__list_milestones",
      "mcp__linear-server__list_projects",
      "mcp__linear-server__list_teams",
      "mcp__linear-server__list_users",
      "mcp__linear-server__save_comment",
      "mcp__linear-server__save_issue",
      "mcp__miro__board_list_items",
      "mcp__miro__context_explore",
      "mcp__miro__context_get",
      "mcp__miro__diagram_get_dsl",
      "mcp__miro__doc_get",
      "mcp__miro__image_get_data",
      "mcp__miro__image_get_url",
      "mcp__miro__table_list_rows",
      "mcp__notion__notion-create-pages",
      "mcp__notion__notion-fetch",
      "mcp__notion__notion-get-comments",
      "mcp__notion__notion-get-teams",
      "mcp__notion__notion-get-users",
      "mcp__notion__notion-query-data-sources",
      "mcp__notion__notion-query-meeting-notes",
      "mcp__notion__notion-search",
      "mcp__notion__notion-update-page",
      "mcp__plugin_figma_figma__get_design_context",
      "mcp__plugin_figma_figma__get_metadata",
      "mcp__plugin_figma_figma__get_screenshot"
    ]
  },
  "sandbox": {
    "allowUnsandboxedCommands": true,
    "enabled": false,
    "excludedCommands": [
      "docker",
      "npx playwright",
      "pnpm dev",
      "pnpm exec playwright",
      "pnpm start",
      "pnpm test:e2e"
    ],
    "failIfUnavailable": false,
    "filesystem": {
      "allowWrite": [
        "./",
        "/tmp",
        "~/.cache",
        "~/.claude",
        "~/.npm",
        "~/Library/Caches",
        "~/Library/pnpm"
      ],
      "denyRead": [
        "~/.aws/credentials",
        "~/.gnupg",
        "~/.ssh"
      ]
    },
    "network": {
      "allowedDomains": [
        "*.miro.com",
        "127.0.0.1",
        "api.anthropic.com",
        "api.figma.com",
        "api.github.com",
        "api.linear.app",
        "api.notion.com",
        "codeload.github.com",
        "github.com",
        "localhost",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "registry.npmjs.org",
        "user-images.githubusercontent.com",
        "www.figma.com"
      ]
    }
  },
  "theme": "light"
}
