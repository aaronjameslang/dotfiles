" Core Settings
filetype plugin indent on
syntax enable
set modeline

" Display
set number
set colorcolumn=+1
set linebreak
set wrap
let &showbreak = '!> '
set list "show invisible characters
set listchars=precedes:<,extends:>,tab:>\ ,trail:-,nbsp:_

" Indentation & Tabs
set expandtab
set tabstop=2
set shiftwidth=2

" Text Formatting
set textwidth=72
set nojoinspaces

" Search
set hlsearch

" Spelling
set spelllang=en_gb

" Mouse & Input
set mouse=a
set mousemodel=popup_setpos

" Clipboard
"set clipboard=unnamedplus
