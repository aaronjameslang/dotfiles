#!/bin/sh
# Usage: gh-stale-repos [--field pushed|updated] [--limit N] [--include-archived]
#
# Lists GitHub repos you can access (owner / collaborator / org member),
# sorted by date oldest-first, so you can see what's gone stale.
#
# --field            pushed (default) | updated
# --limit            number of rows to show (default 10)
# --include-archived include archived repos (excluded by default)
set -eu

field="pushed_at"
limit=10
include_archived=0

usage() {
  sed -n '2,4p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

# Select account if multiple authorized
select_account() {
  local hosts
  hosts=$(gh auth status --json hosts --jq '.hosts.["github.com"].[].login' 2>/dev/null || echo "github.com")

  local host_count
  host_count=$(echo "$hosts" | wc -l)

  if [ "$host_count" -gt 1 ]; then
    echo "Multiple GitHub accounts:" >&2
    echo "$hosts" | nl >&2
    printf "Select (1-%d): " "$host_count" >&2
    read -r selection
    echo "$hosts" | sed -n "${selection}p"
  else
    echo "$hosts" | head -1
  fi
}

while [ $# -gt 0 ]; do
  case "$1" in
    --field)
      case "${2:-}" in
        pushed)  field="pushed_at" ;;
        updated) field="updated_at" ;;
        *) echo "error: --field must be 'pushed' or 'updated'" >&2; usage 1 ;;
      esac
      shift 2
      ;;
    --limit)
      limit="${2:?--limit needs N}"
      shift 2
      ;;
    --include-archived)
      include_archived=1
      shift
      ;;
    -h|--help) usage 0 ;;
    *) echo "error: unknown arg: $1" >&2; usage 1 ;;
  esac
done

# Select account if multiple authorized
login=$(select_account)
gh auth switch --user "$login"

gh api --paginate \
  '/user/repos?affiliation=owner,collaborator,organization_member&per_page=100' \
  | jq -sr --arg f "$field" --argjson n "$limit" --argjson inc "$include_archived" '
      add
      | map(select($inc == 1 or .archived == false))
      | sort_by(.[$f])
      | .[:$n]
      | .[]
      | [.[$f], .full_name, (if .archived then "yes" else "no" end), .html_url]
      | @tsv
    ' \
  | awk -F'\t' '
      BEGIN {
        h1 = "DATE"; h2 = "REPO"; h3 = "ARCHIVED"
        w1 = length(h1); w2 = length(h2); w3 = length(h3)
      }
      {
        date[NR] = $1; repo[NR] = $2; arch[NR] = $3; url[NR] = $4
        if (length($1) > w1) w1 = length($1)
        if (length($2) > w2) w2 = length($2)
        if (length($3) > w3) w3 = length($3)
      }
      END {
        esc = sprintf("%c", 27)
        printf "%-*s  %-*s  %-*s\n", w1, h1, w2, h2, w3, h3
        for (i = 1; i <= NR; i++) {
          pad = w2 - length(repo[i])
          link = esc "]8;;" url[i] esc "\\" repo[i] esc "]8;;" esc "\\"
          printf "%-*s  %s%*s  %-*s\n", w1, date[i], link, pad, "", w3, arch[i]
        }
      }
    '
